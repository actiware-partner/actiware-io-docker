# Legend:
#   required: Must be set - the service will not work without this value.
#   optional: Pre-configured with a sensible default. Override only if needed.

# =============================================================================
# INSTANCE
# =============================================================================

# optional: Port prefix for this instance (Production=30, Test=40)
INSTANCE_PORT_PREFIX=30

# optional: Timezone for all services - see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE="Europe/Berlin"

# optional: Default system locale (run "locale -a" on Linux to list available options)
LANGUAGE="en_US.UTF-8"

# optional: Locale used by PostgreSQL (note: de_DE.UTF-8 is not supported by PostgreSQL)
LANG_POSTGRES="en_US.utf8"

# =============================================================================
# CERTIFICATES & TLS
# =============================================================================

# optional: Path to the server certificate on the host (PEM format)
CERT_SERVER_CRT=/aw/certs/server.crt

# optional: Path to the server private key on the host (PEM format)
CERT_SERVER_KEY=/aw/certs/server.key

# optional: Path to the CA certificate on the host (PEM format)
CERT_CA_CRT=/aw/CAs/ca.crt

# optional: Directory containing server.crt and server.key - used by qdrant and redis
CERT_DIR=../certs

# optional: Directory containing ca.crt - used by redis
CA_DIR=../CAs

# =============================================================================
# SERVICES
# =============================================================================

# optional: Docker log driver settings for all services
LOG_SERVICE_DRIVER=json-file
LOG_SERVICE_SIZE=10m
LOG_SERVICE_FILES=3

# =============================================================================
# SOLR
# =============================================================================

SOLR_TOKEN=<KEY>
SOLR_USER=<USERNAME>
SOLR_PASS=<PASSWORD>
SOLR_HEAP=1G

# =============================================================================
# VECTORSTORE
# =============================================================================

QDRANT_API_KEY=<KEY>
WEAVIATE_API_KEY=<KEY>

# =============================================================================
# STORAGE (S3 / MinIO)
# =============================================================================

# required: Access credentials for the S3-compatible object storage
S3_ACCESS_KEY=<USERNAME>
S3_SECRET_KEY=<PASSWORD>

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

# required: Credentials used to initialize and access the database
DATABASE_USER=<USERNAME>
DATABASE_PASS=<PASSWORD>

# =============================================================================
# VERSION TAGS - INFRASTRUCTURE
# =============================================================================

VERSION_TAG_IO_BACKEND_POSTGRES=18
VERSION_TAG_IO_BACKEND_REDIS=8
VERSION_TAG_IO_BACKEND_QDRANT=v1
VERSION_TAG_IO_BACKEND_SOLR=9
VERSION_TAG_IO_BACKEND_S3=RELEASE.2024-12-13T22-19-12Z
VERSION_TAG_IO_BACKEND_WEAVIATE=1.38.3
VERSION_TAG_IO_BACKEND_RERANKER=cross-encoder-ms-marco-MiniLM-L-6-v2
