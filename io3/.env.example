# Legend:
#   required: Must be set - the service will not work without this value.
#   optional: Pre-configured with a sensible default. Override only if needed.

# =============================================================================
# INSTANCE
# =============================================================================

# required: External hostname or IP address used to reach this instance
EXTERNALADDRESS=<SERVERNAME>

# optional: Port prefix for this instance (Production=30, Test=40)
INSTANCE_PORT_PREFIX=30

# optional: HTTP scheme - set to "https" when SSL/TLS is enabled
INSTANCE_HTTP_TYPE=https

# optional: Timezone for all services - see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE="Europe/Berlin"

# optional: Default system locale (run "locale -a" on Linux to list available options)
LANGUAGE="en_US.UTF-8"

# =============================================================================
# CERTIFICATES & TLS
# =============================================================================

# optional: Path to the server certificate on the host (PEM format)
CERT_SERVER_CRT=/aw/certs/server.crt

# optional: Path to the server private key on the host (PEM format)
CERT_SERVER_KEY=/aw/certs/server.key

# optional: Path to the CA certificate on the host (PEM format)
CERT_CA_CRT=/aw/CAs/ca.crt

# =============================================================================
# KERBEROS
# =============================================================================

# optional: Path to the Kerberos keytab directory on the host - used by io-identity-service
KERBEROS_KEYTAB_DIR=/aw/kerberos

# =============================================================================
# IMPORTS
# =============================================================================

# optional: Path to the imports directory on the host - used by io-module-core and io-module-output-manager
IMPORTS_DIR=/aw/imports

# =============================================================================
# SERVICES
# =============================================================================

# optional: Docker log driver settings for all services
LOG_SERVICE_DRIVER=json-file
LOG_SERVICE_SIZE=10m
LOG_SERVICE_FILES=3

# =============================================================================
# SECURITY
# =============================================================================

# required: Default credentials for the default admin user (change immediately after first login!)
DEFAULT_USER=<USERNAME>
DEFAULT_PASS=<PASSWORD>

# required: OAuth2 client credentials used for inter-service authentication
CLIENT_ID=IoClient
CLIENT_SECRET=<PASSWORD>

DEFAULT_VALIDITY_PERIOD=86400

# required: Shared secret for internal service-to-service communication
SHARED_SECRET=<PASSWORD>

# required: Key used for data encryption at rest
ENCRYPTION_KEY=<PASSWORD>

# optional: AI Assistant settings
# Unterstuetzte Provider: OpenAI, AzureOpenAI, Anthropic, Google, Mistral, Ollama, Custom
AI_PROVIDER=openai
AI_MODEL=<MODEL>
AI_API_KEY=<API_KEY>

# =============================================================================
# SOLR
# =============================================================================

SOLR_TOKEN=<KEY>
SOLR_USER=<USERNAME>
SOLR_PASS=<PASSWORD>
SOL_BASE_INDEXNAME=io3-objects

# =============================================================================
# STORAGE (S3 / MinIO)
# =============================================================================

# required: Name prefix for the S3 buckets - must be unique across all instances sharing the same storage
S3_BUCKET_NAME_PREFIX=io3

# required: AWS region (or equivalent) for the S3-compatible object storage
S3_REGION=eu-central-1

# required: Access credentials for the S3-compatible object storage
S3_ACCESS_KEY=<USERNAME>
S3_SECRET_KEY=<PASSWORD>

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

# required: Credentials used to initialize and access the database
DATABASE_USER=<USERNAME>
DATABASE_PASS=<PASSWORD>

# optional: Database connection settings
DATABASE_SERVER=<SERVERNAME>
DATABASE_PORT=30432
DATABASE_ENCODING=UTF8
DATABASE_PREFIX=io3

# =============================================================================
# NOTIFICATION (SMTP / Microsoft Graph)
# =============================================================================

SMTP_PROFILE_FROM_ADDRESS=<FROM_ADDRESS>
SMTP_PROFILE_FROM_NAME=service-default
SMTP_PROFILE_FROM_DISPLAYNAME=ACTIWARE.IO
SMTP_PROFILE_FROM_TRANSPORT=MicrosoftGraph

SMTP_GRAPH_TENANT_ID=<TENANT_ID>
SMTP_GRAPH_CLIENT_ID=<CLIENT_ID>
SMTP_GRAPH_CLIENT_SECRET=<CLIENT_SECRET>

SMTP_BLOCKED_REPORT_RECIPIENTS=<ADMIN_EMAIL_ADDRESS>

# =============================================================================
# VECTORSTORE
# =============================================================================

QDRANT_API_KEY=<KEY>
WEAVIATE_API_KEY=<KEY>

# =============================================================================
# OCR
# =============================================================================

OCR_ENGINE=AI
OCR_PROVIDER=MistralOcr
MISTRAL_API_KEY=<MISTRAL_APIKEY>
MISTRAL_OCR_MODEL=mistral-ocr-latest

# =============================================================================
# VERSION TAGS - BACKEND SERVICES
# =============================================================================

VERSION_IO_SERVICE_IDENTITY=actiwareio/io-identity-service:3-latest
VERSION_IO_SERVICE_VAULT=actiwareio/io-vault-service:3-latest
VERSION_IO_SERVICE_PROJECT=actiwareio/io-project-service:3-latest
VERSION_IO_SERVICE_OBJECT_STORAGE=actiwareio/io-object-storage-service:3-latest
VERSION_IO_SERVICE_WORKER_QUEUE=actiwareio/io-worker-queue-service:3-latest
VERSION_IO_SERVICE_DATA_FLOW=actiwareio/io-data-flow-service:3-latest
VERSION_IO_SERVICE_CLIENT=actiwareio/io-client-service:3-latest
VERSION_IO_SERVICE_AI_CHAT=actiwareio/io-ai-chat-service:3-latest
VERSION_IO_SERVICE_AI_AGENT_FUNCTIONS=actiwareio/io-ai-agent-functions-service:3-latest
VERSION_IO_SERVICE_AI_RAG=actiwareio/io-ai-rag-service:3-latest
VERSION_IO_SERVICE_OCR=actiwareio/io-ocr-service:3-latest
VERSION_IO_SERVICE_SDK=actiwareio/io-sdk-service:3-latest
VERSION_IO_SERVICE_INBOX=actiwareio/io-inbox-service:3-latest
VERSION_IO_SERVICE_WORKFLOW=actiwareio/io-workflow-service:3-latest
VERSION_IO_SERVICE_DOCUMENT_VIEWER=actiwareio/io-document-viewer-service:3-latest
VERSION_IO_SERVICE_DOCS=actiwareio/io-docs-service:3-latest
VERSION_IO_SERVICE_NOTIFICATION=actiwareio/io-notification-service:3-latest
VERSION_IO_SERVICE_LOOKUP=actiwareio/io-lookup-service:3-latest
VERSION_IO_SERVICE_INTEGRATION_FLOW=actiwareio/io-integration-flow-service:3-latest
VERSION_IO_SERVICE_BFF_CLIENT=actiwareio/io-bff-client-service:3-latest


# =============================================================================
# VERSION TAGS - CLIENTS
# =============================================================================

VERSION_IO_CLIENT_DESIGNER=actiwareio/io-designer:3-latest
VERSION_IO_CLIENT_WEB=actiwareio/io-client:3-latest

# =============================================================================
# VERSION TAGS - MODULES
# =============================================================================

VERSION_IO_MODULE_CORE=actiwareio/io-module-core:3-latest
VERSION_IO_MODULE_OUTPUT_MANAGER=actiwareio/io-module-output-manager:3-latest
